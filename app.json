{
  "expo": {
    "name": "Finexa Smart Credit Routes",
    "slug": "finexa-orderbooker",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "finexaapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Finexa to use speech recognition for voice notes.",
        "NSMicrophoneUsageDescription": "Allow Finexa to use the microphone for voice notes."
      }
    },
    "android": {
      "package": "com.finexa.smartcreditroutes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#4338CA"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Finexa to track your route location in the background for route monitoring.",
          "locationWhenInUsePermission": "Allow Finexa to access your location for GPS verification during recovery collection."
        }
      ],
      [
        "./plugins/withDirectSms.js",
        {
          "sendSmsPermission": "Allow Finexa Recovery App to send SMS notifications for recovery updates."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "recordAudioPermission": "Allow Finexa to use microphone for voice notes (Speech-to-Text)."
        }
      ],
      "./plugins/withAndroidBuildFix.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2371ff21-2edc-4261-b18d-b6b44f84d734"
      }
    }
  }
}
